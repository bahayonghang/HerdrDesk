<UserControl
    x:Class="HerdDesk.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="诊断">
    <ScrollViewer>
        <StackPanel Padding="16" Spacing="8">
            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="诊断" />
            <ListView x:Name="FieldList" AutomationProperties.Name="诊断" />
            <Button
                x:Name="PreviewButton"
                Click="OnPreview"
                Content="导出预览" />
            <Button
                x:Name="ConfirmButton"
                Click="OnConfirm"
                Content="确认导出" />
            <TextBox
                x:Name="ExportPathBox"
                Header="导出路径" />
            <Button
                x:Name="ExportButton"
                Click="OnExport"
                Content="导出" />
            <TextBlock x:Name="StatusText" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
