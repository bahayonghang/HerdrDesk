<UserControl
    x:Class="HerdDesk.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="关于">
    <StackPanel Padding="16" Spacing="8">
        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="关于" />
        <TextBlock x:Name="NameText" />
        <TextBlock x:Name="VersionText" />
        <TextBlock
            x:Name="StatementText"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
