<UserControl
    x:Class="HerdDesk.App.Controls.SearchPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="搜索">
    <Border
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
        BorderThickness="1"
        Padding="12">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="QueryBox"
                AutomationProperties.Name="搜索"
                PlaceholderText="搜索名称、类型、设备"
                PreviewKeyDown="OnQueryPreviewKeyDown"
                TextChanged="OnQueryChanged" />
            <ListView
                x:Name="ResultList"
                Grid.Row="1"
                AutomationProperties.Name="搜索"
                IsItemClickEnabled="True"
                ItemClick="OnResultClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,4">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="{Binding KindLabel}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
