<UserControl
    x:Class="HerdDesk.App.Controls.DeviceSessionRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="设备与会话">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Padding="12,8,12,4"
            AutomationProperties.Name="设备与会话"
            Text="设备与会话" />
        <Grid Grid.Row="1">
            <ListView
                x:Name="RailList"
                AutomationProperties.Name="设备与会话"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,4" Spacing="2">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="{Binding Display}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                x:Name="EmptyHint"
                Padding="12,8"
                Spacing="8"
                AutomationProperties.Name="没有设备"
                Visibility="Collapsed">
                <TextBlock Text="没有设备" />
                <Button
                    AutomationProperties.Name="添加设备"
                    Click="OnAddDevice"
                    Content="添加设备" />
                <Button
                    AutomationProperties.Name="诊断"
                    Click="OnDiagnostics"
                    Content="诊断" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
