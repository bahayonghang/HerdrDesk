{
  "kind": "synthetic_rpc_schema_v1_cases",
  "simulation": true,
  "runtime_pass": false,
  "fixture_origin": "synthetic",
  "herdr_executed": false,
  "cases": [
    {
      "name": "missing_version",
      "expect": "rpc_required_field_missing",
      "raw": "{\"id\":\"1\",\"result\":{\"type\":\"session_snapshot\",\"snapshot\":{\"protocol\":22,\"workspaces\":[],\"tabs\":[],\"panes\":[],\"layouts\":[],\"agents\":[]}}}"
    },
    {
      "name": "protocol_wrong_type",
      "expect": "rpc_field_type_invalid",
      "raw": "{\"id\":\"1\",\"result\":{\"type\":\"session_snapshot\",\"snapshot\":{\"version\":\"0.9.0\",\"protocol\":\"22\",\"workspaces\":[],\"tabs\":[],\"panes\":[],\"layouts\":[],\"agents\":[]}}}"
    },
    {
      "name": "duplicate_json_key",
      "expect": "duplicate_json_key",
      "raw": "{\"version\":\"0.9.0\",\"protocol\":22,\"version\":\"x\",\"workspaces\":[],\"tabs\":[],\"panes\":[],\"layouts\":[],\"agents\":[]}"
    },
    {
      "name": "error_envelope",
      "expect": "rpc_error_envelope",
      "raw": "{\"id\":\"1\",\"error\":{\"code\":\"workspace_group_close_required\",\"message\":\"group\"}}"
    },
    {
      "name": "negative_revision",
      "expect": "rpc_field_type_invalid",
      "raw": "{\"version\":\"0.9.0\",\"protocol\":22,\"workspaces\":[],\"tabs\":[],\"panes\":[{\"pane_id\":\"p1\",\"terminal_id\":\"t\",\"workspace_id\":\"w1\",\"tab_id\":\"t1\",\"focused\":true,\"agent_status\":\"idle\",\"revision\":-1}],\"layouts\":[],\"agents\":[]}"
    },
    {
      "name": "unknown_event",
      "expect": "ok",
      "raw": "{\"event\":\"pane_future_signal\",\"data\":{\"type\":\"pane_future_signal\",\"pane_id\":\"w1:p1\",\"future_flag\":true}}"
    }
  ]
}
